{
  "name": "datayacht-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingestion pipeline: parses the /knowledge markdown corpus into a SQLite nodes+edges graph.",
  "scripts": {
    "ingest": "node src/ingest.js",
    "ingest:clean": "node scripts/cleanDb.mjs && node src/ingest.js",
    "verify-export": "node src/exporters/verifyExport.js",
    "score": "node src/reporters/completenessScore.js",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
